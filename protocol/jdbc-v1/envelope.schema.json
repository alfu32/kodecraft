{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kode-rs.invalid/protocol/jdbc-v1/envelope.schema.json",
  "type": "object",
  "required": ["jsonrpc"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern":"^[^\u0000-\u001f\u007f-\u009f]+$"},
    "method": {"type": "string", "minLength": 1, "maxLength": 128, "pattern":"^[^\u0000-\u001f\u007f-\u009f]+$"},
    "params": {"type": "object"},
    "error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "integer", "minimum":-9223372036854775808,"maximum":9223372036854775807}, "message": {"type": "string"}}}
  },
  "oneOf": [
    {"required": ["method"], "not": {"anyOf": [{"required": ["result"]}, {"required": ["error"]}]}},
    {"required": ["id", "result"], "not": {"anyOf": [{"required": ["method"]}, {"required": ["error"]}]}},
    {"required": ["id", "error"], "not": {"anyOf": [{"required": ["method"]}, {"required": ["result"]}]}}
  ]
}
